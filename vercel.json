{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*\\.html|/|/portfolio|/blogs|/blog|/blog/.*|/about|/services|/pricing|/contact|/testimonials|/tools)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate, max-age=0, s-maxage=0"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/diagnostics",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/supabase_index_raw",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "loufypublish.vercel.app"
        }
      ],
      "destination": "https://loufypublisher.com/$1",
      "permanent": true
    },
    {
      "source": "/blog/bestselling-book-interior-fonts-layout",
      "destination": "/blog/book-interior-formatting-for-kdp",
      "permanent": true
    },
    {
      "source": "/blog/hardcover-formatting-margin-spine-calculations",
      "destination": "/blog/kdp-paperback-cover-size-guide",
      "permanent": true
    },
    {
      "source": "/blog/cost-of-self-publishing-launch-budget",
      "destination": "/blog/how-much-does-a-book-cover-design-cost",
      "permanent": true
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "query",
          "key": "slug",
          "value": "(?<slug>.*)"
        }
      ],
      "destination": "/blog/:slug",
      "permanent": true
    },
    {
      "source": "/blog",
      "missing": [
        {
          "type": "query",
          "key": "slug"
        }
      ],
      "destination": "/blogs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/blogs/:category",
      "destination": "/blogs?category=:category"
    },
    {
      "source": "/blogs/category/:category",
      "destination": "/blogs?category=:category"
    },
    {
      "source": "/blog/:slug",
      "destination": "/api/blog-preview?slug=:slug"
    },
    {
      "source": "/portfolio/:category/:genre",
      "destination": "/portfolio?category=:category&genre=:genre"
    },
    {
      "source": "/portfolio/:category",
      "destination": "/api/portfolio-preview?category=:category"
    }
  ]
}
